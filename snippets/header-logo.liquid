{% comment %}
  Renders the simplified header logo used by the checkout-flow layouts
  (session, cart) and the minimal layout.

  Accepts:
  - link_url: {String} URL the logo links to (e.g. routes.back_to_website_url or routes.root_url)
  - shop: {Object} the shop, used for shop.name and shop.logo_url fallbacks
  - section: {Object} the layout section, used for section.settings.logo / custom_title (optional)
{% endcomment %}
<div class="header__wrapper">
  <div>
    <a href="{{ link_url }}" class="header__link">
      {% if section.settings.logo.url != blank %}
        <img
          src="{{ section.settings.logo | image_url }}"
          alt="{{ shop.name }}"
          class="header__image-logo"
        >
      {% elsif section.settings.custom_title != blank %}
        <h1 class="header__text-logo">{{ section.settings.custom_title }}</h1>
      {% elsif shop.logo_url != blank %}
        <img
          src="{{ shop.logo_url }}"
          alt="{{ shop.name }}"
          class="header__image-logo"
        >
      {% else %}
        <h1 class="header__text-logo">{{ shop.name }}</h1>
      {% endif %}
    </a>
  </div>
</div>
