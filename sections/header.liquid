{% assign app = section.blocks | where: "type", "app" | first -%}
{%  assign collections_size = non_system_collections | size %}

{% if app %}
  {{ "app.css" | asset_url | stylesheet_tag }}
{% endif %}

<style>
  {% if section.settings.background_color != blank %}
    .header,
    .header__wrapper,
    .header__nav .list-submenu,
    .header__nav-submenu,
    .header-search__input,
    .header-floating-menu__wrapper,
    .header-search__wrapper {
      background-color: {{ section.settings.background_color }} !important;
    }

    .header-search__input:autofill,
    .header-search__input:-webkit-autofill {
      background-color: {{ section.settings.background_color }} !important;
    }
  {% endif %}

  {% if section.settings.foreground_color != blank %}
    .header__text-logo,
    .header__nav-item,
    .header__nav--desktop .header__nav-link,
    .header-search__input,
    .header-search__icon,
    .header-floating-menu__icon,
    .header__nav .list-menu__item .list-menu__item-caret,
    .header-cart .header-cart__spinner,
    .header__link img {
      color: {{ section.settings.foreground_color }};
    }

    .header__nav--desktop .header__nav-link:hover span {
      border-color: {{ section.settings.foreground_color }};
    }

    .header-search__input {
      border-color: {{ section.settings.foreground_color }} !important;
    }

    .header-search__input::placeholder {
      color: {{ section.settings.foreground_color | append: "B3"  }} !important;
    }

    .header-search__input:focus {
      border-color: {{ section.settings.foreground_color }} !important;
    }

    .list-menu--vertical > .list-menu__item {
      border-color: {{ section.settings.foreground_color | append: "66" }} !important;
    }

    .header-cart bq-minicart-button {
      --minicart-button-color: {{ section.settings.foreground_color }};
      --minicart-button-hover-color: {{ section.settings.foreground_color }};
    }

  {% endif %}
</style>

<div class="header__wrapper {% if show_mini_cart %} header__wrapper--with-mini-cart{% else %} header__wrapper--without-mini-cart{% endif %}">
  {%- comment -%} Product, search and 404 pages render their own h1 {%- endcomment -%}
  {% if template == "product" or template == "search" or template == "404" %}
    {% assign logo_tag = "div" %}
  {% else %}
    {% assign logo_tag = "h1" %}
  {% endif %}

  <div class="header__link-container">
    <a href="{{ routes.root_url }}" class="header__link">
      {% if section.settings.logo.url != blank %}
        <{{ logo_tag }} class="header__logo-heading">
          <img
            src="{{ section.settings.logo | image_url }}"
            alt="{{ shop.name }}"
            class="header__image-logo"
          >
        </{{ logo_tag }}>
      {% elsif section.settings.custom_title != blank %}
        <{{ logo_tag }} class="header__text-logo">{{ section.settings.custom_title }}</{{ logo_tag }}>
      {% elsif shop.logo_url != blank %}
        <{{ logo_tag }} class="header__logo-heading">
          <img
            src="{{ shop.logo_url }}"
            alt="{{ shop.name }}"
            class="header__image-logo"
          >
        </{{ logo_tag }}>
      {% else %}
        <{{ logo_tag }} class="header__text-logo">{{ shop.name }}</{{ logo_tag }}>
      {% endif %}
    </a>
  </div>

  <div class="header__actions-container">
    {% assign search_label = "store.search_products" | user_t %}
    <div class="header-search">
        <button type="button" class="header-search__trigger" aria-label="{{ search_label }}" aria-expanded="false" aria-controls="header-search-wrapper">
        {% render 'icon', name: 'magnifying-glass', style: 'light', class: 'header-search__icon open' %}
        </button>
        <div class="header-search__wrapper" id="header-search-wrapper">
        <form id="search" action="{{ routes.search_url }}" role="search">
            <div class="header-search__input-wrapper">
            {% render 'icon', name: 'magnifying-glass', style: 'light', class: 'header-search__icon' %}
            <input type="search" name="q" class="header-search__input" placeholder="{{ search_label }}" aria-label="{{ search_label }}">
            </div>
            <button type="button" class="header-search__trigger" aria-label="{{ "store.close" | user_t }}" aria-expanded="false" aria-controls="header-search-wrapper">
            {% render 'icon', name: 'xmark', style: 'light', class: 'header-search__icon close' %}
            </button>
        </form>
        </div>
    </div>

    {% if show_mini_cart %}
        <div class="header-cart">
        {{ cart_button }}
        {% render 'icon', name: 'spinner-third', style: 'regular', class: 'header-cart__spinner icon--spin' %}
        </div>
    {% endif %}

    {% if collections_size > 0 %}
        <div class="collection-floating-menu">
        <button class="header-collection-floating-menu__trigger" onclick="handleOpenCollectionMenu()">
            {% render 'icon', name: 'bars', style: 'regular', class: 'header-collection-floating-menu__icon open' %}
        </button>
        </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "header",
  "templates": [],
  "layout": true,
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Translations"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "What are you looking for?"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom title",
      "description": "Note: Header logo always overrides this title"
    },
    {
      "type": "menu",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "color",
      "id": "foreground_color",
      "label": "Foreground color",
      "placeholder": "Default"
    }
  ]
}
{% endschema %}
